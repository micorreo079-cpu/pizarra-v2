<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!-- Espaciador superior: empuja el contenido al centro -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <EditText
        android:id="@+id/ipInput"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:hint="IP:Port (Optional)"
        android:inputType="text"
        android:textColor="@android:color/black"
        android:textColorHint="#757575" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAutoConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="AutoConnect" />

        <Button
            android:id="@+id/btnManualConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Input IP" />
    </LinearLayout>

    <!-- Modo V2: la pizarra hace de SERVIDOR de red (el móvil se conecta a ella). -->
    <Button
        android:id="@+id/btnModoV2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#1B5E20"
        android:text="Modo V2" />

    <!-- Espaciador inferior: deja el botón Check updates abajo del todo -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check updates"
        android:textColor="#555555"
        android:backgroundTint="#E0E0E0" />
</LinearLayout>
